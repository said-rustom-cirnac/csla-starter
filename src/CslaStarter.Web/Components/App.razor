@using System.Globalization
@inject CslaStarter.Infrastructure.Web.CspNonce CspNonce
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csp-nonce" content="@CspNonce.Value" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/CslaStarter.Components/gcds/dist/gcds/gcds.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CslaStarter.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce.Value" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
