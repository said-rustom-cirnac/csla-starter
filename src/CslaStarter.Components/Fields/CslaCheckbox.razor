@inherits CslaFieldBase<bool>
@if (Info.Visible)
{
    <div data-changed="@IsChanged" data-highlighted="@IsHighlighted">
        @if (Info.ReadOnly)
        {
            <p id="@FieldId" data-label="@LabelText">@Text</p>
        }
        else
        {
            <gcds-checkboxes id="@FieldId" name="@PropertyName" options="@OptionsJson" hint="@Info.Hint" error-message="@Info.Error" required="@Info.Required" validate-on="other" @ongcdschange="OnChange" @ongcdsblur="OnBlur"></gcds-checkboxes>
        }
    </div>
}
