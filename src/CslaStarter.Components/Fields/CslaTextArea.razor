@inherits CslaFieldBase<string?>
@if (Info.Visible)
{
    <div data-changed="@IsChanged" data-highlighted="@IsHighlighted">
        @if (Info.ReadOnly)
        {
            <p id="@FieldId" data-label="@LabelText">@Text</p>
        }
        else
        {
            <gcds-textarea id="@FieldId" textarea-id="@InputId" name="@PropertyName" label="@LabelText" hint="@Info.Hint" error-message="@Info.Error" required="@Info.Required" character-count="@Info.MaxLength" validate-on="other" value="@Text" @ongcdsinput="OnInput" @ongcdsblur="OnBlur"></gcds-textarea>
        }
    </div>
}
