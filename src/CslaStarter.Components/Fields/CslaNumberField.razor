@typeparam TValue
@inherits CslaFieldBase<TValue>
@if (Info.Visible)
{
    <div data-changed="@IsChanged" data-highlighted="@IsHighlighted">
        <gcds-input id="@FieldId" input-id="@InputId" name="@PropertyName" type="number" label="@LabelText" hint="@Info.Hint" error-message="@Info.Error" required="@Info.Required" readonly="@Info.ReadOnly" step="@Step" validate-on="other" value="@Text" @ongcdsinput="OnInput" @ongcdsblur="OnBlur"></gcds-input>
        <CslaFieldHistoryButton Model="Model" Property="@PropertyName" Label="@LabelText" />
    </div>
}
