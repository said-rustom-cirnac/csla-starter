@inherits CslaStarter.Components.Base.CslaBaseComponent
@if (Warning)
{
    <dialog open role="alertdialog" aria-describedby="@MessageId" data-csla-session>
        <p id="@MessageId">@WarningText</p>
        <gcds-button type="button" data-action="stay" @ongcdsclick="StaySignedIn">@Messages.Session_Stay</gcds-button>
    </dialog>
}
<form method="post" action="/account/signout" @ref="_signOutForm" data-csla-signout hidden>
    <AntiforgeryToken />
</form>
