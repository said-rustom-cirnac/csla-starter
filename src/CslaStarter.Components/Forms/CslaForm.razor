@typeparam T where T : class
@inherits CslaBaseComponent<T>
<form id="@ComponentId" novalidate @onsubmit="SubmitAsync">
    @if (!IsClosed && FormContext is not null)
    {
        @if (Topic is { } topic)
        {
            <CslaPresenceIndicator Topic="topic" />
        }

        @if (RemoteChange is not null)
        {
            <CslaChangeBanner ChangedBy="@RemoteChange.ChangedByName" Deleted="@(RemoteChange.Kind == Core.Realtime.ChangeKind.Deleted)" OnReload="ReloadAsync" OnKeepMine="KeepMine" />
        }

        @if (DraftOffer is not null)
        {
            <CslaDraftPrompt SavedAt="DraftOffer.SavedAt" RecordChanged="@DraftRecordChanged" OnRestore="RestoreDraftAsync" OnDiscard="DiscardDraftAsync" />
        }

        @if (Conflict is not null)
        {
            <CslaConflictDialog Differences="Conflict.Differences" BothChanged="Conflict.BothChanged" OnUseTheirs="UseTheirsAsync" OnApplyMine="ApplyMineAsync" />
        }

        @if (History is { } history)
        {
            <dialog open data-csla-field-history>
                <CslaHistory EntityType="@history.EntityType" EntityKey="@history.EntityKey" Property="@history.Property" />
                <gcds-button type="button" button-role="secondary" data-action="close-history" @ongcdsclick="CloseHistory">@Messages.Common_Close</gcds-button>
            </dialog>
        }

        <CascadingValue TValue="ICslaFormContext" Value="FormContext" IsFixed="true">
            <CascadingValue TValue="CslaFormState" Value="State">
                <CslaErrorSummary />
                @ChildContent?.Invoke(FormContext)
            </CascadingValue>
        </CascadingValue>
    }
</form>
